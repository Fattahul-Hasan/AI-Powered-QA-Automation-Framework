{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gap-analysis.schema.json",
  "title": "Gap Analysis Artifact",
  "description": "ARCHITECTURE.md Section 12 / Section I (Gap-Analysis Model).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^GAP-" },
    "runId": { "type": "string" },
    "phase": { "const": "gap-analysis" },
    "producedBy": { "const": "gap-analysis" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["ok", "partial", "failed"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "data": {
      "type": "object",
      "properties": {
        "requirementsWithoutTests": { "type": "array", "items": { "type": "string" } },
        "testsWithoutRequirements": { "type": "array", "items": { "type": "string" } },
        "testCasesWithoutAutomation": { "type": "array", "items": { "type": "string" } },
        "modulesWithoutAutomation": { "type": "array", "items": { "type": "string" } },
        "missingNegativeTests": { "type": "array", "items": { "type": "string" } },
        "missingPermissionTests": { "type": "array", "items": { "type": "string" } },
        "missingRegressionCoverage": { "type": "array", "items": { "type": "string" } },
        "failedTests": { "type": "array", "items": { "type": "string" } },
        "flakyTests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testCaseId": { "type": "string" },
              "history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "runId": { "type": "string" },
                    "result": { "enum": ["passed", "failed"] }
                  },
                  "required": ["runId", "result"]
                }
              },
              "flakyFrequency": { "type": "number", "minimum": 0, "maximum": 1 },
              "quarantineRecommended": { "type": "boolean" }
            },
            "required": ["testCaseId", "history"]
          }
        },
        "partiallyCoveredRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirementId": { "type": "string" },
              "automatedCount": { "type": "integer", "minimum": 0 },
              "totalTestCases": { "type": "integer", "minimum": 0 }
            },
            "required": ["requirementId", "automatedCount", "totalTestCases"]
          }
        },
        "staleAutomation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testCaseId": { "type": "string" },
              "lastExecutedAt": { "type": "string" },
              "daysSinceExecution": { "type": "number" }
            },
            "required": ["testCaseId", "lastExecutedAt", "daysSinceExecution"]
          }
        },
        "stalenessWindowDays": { "type": "integer", "minimum": 1 }
      },
      "required": ["requirementsWithoutTests", "testCasesWithoutAutomation", "staleAutomation", "stalenessWindowDays"],
      "additionalProperties": true
    }
  },
  "required": ["id", "runId", "phase", "producedBy", "schemaVersion", "status", "data"],
  "additionalProperties": false
}
