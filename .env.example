# Environment configuration template for AI-QA-Automation-Framework.
# Copy this file to .env and fill in real values locally. NEVER commit .env.
# See ARCHITECTURE.md Section B (Authentication) and Section L (Security/Secrets).

# --- Application under test -------------------------------------------------
# Real target application base URL. Until a target is approved (see ARCHITECTURE.md
# "Phase 1 Status"), leave this unset — playwright.config.js falls back to a public
# placeholder (https://playwright.dev) so the existing smoke test keeps passing.
BASE_URL=

# --- Authentication roles (ARCHITECTURE.md Section B) -----------------------
# One USERNAME/PASSWORD pair per role that needs a reusable authenticated session.
# These two roles are examples only — add/rename per the real application's roles.
ADMIN_USERNAME=
ADMIN_PASSWORD=
STANDARD_USER_USERNAME=
STANDARD_USER_PASSWORD=

# --- GitLab MCP (.mcp.json — read-only per ARCHITECTURE.md Section G) -------
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_API_URL=

# --- Environment safety (.framework/lib/environment-safety.js) --------------
# Required once BASE_URL above is set to a real (non-placeholder) target -- production
# execution is blocked by default. Leave unset while BASE_URL is unset; has no effect then.
# TEST_ENVIRONMENT=non-production
# Optional defense-in-depth: comma-separated hostnames that are hard-blocked even if
# TEST_ENVIRONMENT=non-production is set (e.g. known production hostnames).
# PRODUCTION_HOSTS=

# --- Test execution (optional overrides) -------------------------------------
# TEST_RETRIES=
# GAP_ANALYSIS_STALENESS_DAYS=14
