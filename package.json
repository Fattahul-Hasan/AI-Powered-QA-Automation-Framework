{
  "name": "ai-qa-automation-framework",
  "version": "1.0.0",
  "description": "AI-agentic web automation testing framework built on Playwright, MCP, and Claude Code.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed --project=chromium",
    "test:functional": "playwright test tests/functional --project=chromium",
    "test:positive": "playwright test tests/positive --project=chromium",
    "test:negative": "playwright test tests/negative --project=chromium",
    "test:regression": "playwright test tests/regression --project=chromium",
    "test:module": "playwright test --project=chromium --grep",
    "test:framework": "playwright test --project=framework",
    "test:all": "playwright test",
    "report": "playwright show-report",
    "agent:requirement": "node .framework/cli.js requirement-analysis",
    "agent:discover": "node .framework/cli.js product-discovery",
    "agent:design": "node .framework/cli.js test-design",
    "agent:data": "node .framework/cli.js test-data",
    "agent:generate": "node .framework/cli.js automation-generation",
    "agent:execute": "node .framework/cli.js execution",
    "agent:analyze": "node .framework/cli.js failure-analysis",
    "agent:heal": "node .framework/cli.js self-healing",
    "agent:gap": "node .framework/cli.js gap-analysis",
    "agent:regression": "node .framework/cli.js regression",
    "agent:report": "node .framework/cli.js reporting",
    "framework:dry-run": "node .framework/cli.js dry-run",
    "test:smoke": "node .framework/run-profile.js smoke",
    "test:sanity": "node .framework/run-profile.js sanity",
    "test:api": "node .framework/run-profile.js api",
    "test:ui": "node .framework/run-profile.js ui",
    "test:changed": "node .framework/run-profile.js changed",
    "artifact:prune": "node .framework/cli.js prune-runs",
    "release:readiness": "node .framework/cli.js release-readiness"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "@zereight/mcp-gitlab": "^2.1.52",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2"
  }
}
